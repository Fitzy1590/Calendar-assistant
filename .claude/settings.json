{
  "permissions": {
    "deny": [
      "Read(./**/*.jks)",
      "Read(./**/*.key)",
      "Read(./**/*.keystore)",
      "Read(./**/*.lock)",
      "Read(./**/*.p12)",
      "Read(./**/.env)",
      "Read(./**/.env*)",
      "Read(./**/.env.local)",
      "Read(./**/client_secret*.json)",
      "Read(./.env)",
      "Read(./.env*)",
      "Read(./.env.local)",
      "Read(./build/**)",
      "Read(./dist/**)",
      "Read(./node_modules/**)",
      "Read(./package-lock.json)",
      "Read(./secrets/**)",
      "Read(./signing/*.p12)",
      "Read(./src-tauri/gen/**)",
      "Read(./src-tauri/target/**)",
      "Read(signing/*.p12)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_response.filePath // .tool_input.file_path // empty'); case \"$f\" in *.ts|*.tsx) npx --no-install prettier --write \"$f\" >/dev/null 2>&1;; esac; true",
            "timeout": 30,
            "statusMessage": "Formatting with Prettier"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && out=$(npm run build 2>&1) || { printf '%s\\n' \"$out\" | head -50 1>&2; exit 2; }",
            "timeout": 180,
            "statusMessage": "Building"
          }
        ]
      }
    ]
  },
  "outputStyle": "concise",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  }
}
