{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/*.key)",
      "Read(./**/*.jks)",
      "Read(./**/client_secret*.json)",
      "Read(./**/*.p12)",
      "Read(./**/*.keystore)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_response.filePath // .tool_input.file_path // empty'); case \"$f\" in *.ts|*.tsx) npx --no-install prettier --write \"$f\" >/dev/null 2>&1;; esac; true",
            "timeout": 30,
            "statusMessage": "Formatting with Prettier"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npx tsc --noEmit 1>&2 || exit 2",
            "timeout": 120,
            "statusMessage": "Type checking"
          }
        ]
      }
    ]
  }
}
