{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window on Windows and Android",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-decorations",
    "core:window:allow-is-decorated",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-is-maximized",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-current-monitor",
    "notification:default",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    "oauth:allow-start",
    "oauth:allow-cancel",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "tel:*"
        },
        {
          "url": "sms:*"
        },
        {
          "url": "mailto:*"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://news.google.com/*"
        },
        {
          "url": "https://www.thesportsdb.com/*"
        },
        {
          "url": "https://app.ticketmaster.com/*"
        },
        {
          "url": "https://api.open-meteo.com/*"
        },
        {
          "url": "https://geocoding-api.open-meteo.com/*"
        },
        {
          "url": "https://nominatim.openstreetmap.org/*"
        },
        {
          "url": "https://oauth2.googleapis.com/*"
        },
        {
          "url": "https://raw.githubusercontent.com/Picovoice/*"
        },
        {
          "url": "https://overpass-api.de/*"
        },
        {
          "url": "https://people.googleapis.com/*"
        },
        {
          "url": "https://*"
        }
      ]
    }
  ]
}